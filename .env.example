# ==================== APP ====================
NODE_ENV=development
PORT=5000
DEBUG=true

# ==================== DATABASE ====================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/oryntis

# ==================== REDIS ====================
REDIS_URL=redis://localhost:6379

# ==================== JWT ====================
SECRET_KEY=oryntis-dev-secret-key-change-for-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ==================== FRONTEND ====================
FRONTEND_URL=http://localhost:3000

# ==================== INSFORGE (Backend-as-a-Service) ====================
INSFORGE_URL=https://your-project.us-east.insforge.app
INSFORGE_SERVICE_KEY=your-service-role-key
INSFORGE_ANON_KEY=your-anon-key

# ==================== OAUTH ====================
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# ==================== EXTERNAL APIs ====================
ABUSEIPDB_API_KEY=
ALIENVAULT_API_KEY=
VIRUSTOTAL_API_KEY=
SHODAN_API_KEY=

# ==================== RATE LIMITING ====================
RATE_LIMIT_PER_MINUTE=60

# ==================== CREDITS ====================
FREE_CREDITS_MONTHLY=2500